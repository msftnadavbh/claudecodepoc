# Copy to .env.azure.local and replace every example value.
AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_LOCATION=eastus2

# greenfield (default) creates everything; brownfield reuses Foundry resources.
DEPLOYMENT_MODE=greenfield

# Resource names. In greenfield these are created; in brownfield they must exist.
FOUNDRY_RESOURCE_GROUP=rg-claude-code-poc
FOUNDRY_RESOURCE_NAME=your-globally-unique-foundry-name
FOUNDRY_PROJECT_NAME=proj-default

# Select opus, sonnet, or haiku. Exact model/version can override the defaults.
CLAUDE_MODEL_FAMILY=sonnet
CLAUDE_MODEL_NAME=
CLAUDE_MODEL_VERSION=2
CLAUDE_MODEL_CAPACITY=25
CLAUDE_DEPLOYMENT_NAME=

# Required only for greenfield. These values accept Anthropic Marketplace terms.
CLAUDE_ORGANIZATION_NAME="Your legal organization name"
CLAUDE_COUNTRY_CODE=US
CLAUDE_INDUSTRY=technology

# Gateway resources created by this repository.
APIM_RESOURCE_NAME=your-globally-unique-apim-name
APIM_SUBSCRIPTION_NAME=claude-code-poc
LOG_ANALYTICS_WORKSPACE_NAME=log-claude-code-poc
APP_INSIGHTS_NAME=appi-claude-code-poc
PUBLISHER_NAME="Your organization"
PUBLISHER_EMAIL=azure-admin@example.com

# WSL only: retain a dedicated Windows Azure CLI/WAM cache across clones.
AZURE_CLI_CACHE_NAME=claudecodepoc
